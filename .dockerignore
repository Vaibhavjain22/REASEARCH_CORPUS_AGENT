# Ignore python virtual environments
venv/
.venv/
env/

# Ignore local environment keys and logs
.env
.env.local
logs/*.json

# Ignore python caching and bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Ignore IDE settings and VCS
.vscode/
.idea/
.git/
.gitignore

# Ignore local media, evaluation outputs, and logs
Demo_vedio/
evaluation/
*.log
*.tmp
