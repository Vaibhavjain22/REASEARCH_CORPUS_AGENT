# Ignore python virtual environments
venv/
.venv/
env/

# Ignore local environment keys and logs
.env
logs/*.json

# Ignore python caching and bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Ignore IDE settings
.vscode/
.idea/
.git/
.gitignore

# Ignore local database states if we want a fresh start, 
# or keep chroma_db if we want to bundle the default dataset.
# Since we want to bundle the default database of papers, we DO NOT ignore chroma_db/ 
# but we ignore temp upload files.
*.log
